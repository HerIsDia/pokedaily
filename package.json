{
  "name": "pokedaily",
  "version": "4.0.0-dev.1",
  "private": true,
  "description": "Quel Pokémon es-tu aujourd'hui ? — PWA locale, sans compte, sans pub, sans suivi.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Diamant",
    "email": "git@diamant.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/herisdia/pokedaily"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "dex": "node scripts/build-dex.ts",
    "sprites": "node scripts/sync-sprites.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource/roboto-condensed": "^5.3.0"
  }
}
